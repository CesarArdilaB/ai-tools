{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Write|Edit|apply_patch|Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$(git rev-parse --show-toplevel)/scripts/sync-agent-skills.mjs\" --hook",
                        "timeout": 10
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$(git rev-parse --show-toplevel)/scripts/sync-agent-skills.mjs\" --hook",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
