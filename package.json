{
    "name": "ai-tools",
    "version": "0.2.0",
    "private": true,
    "description": "Agent tooling for Claude Code and Codex: shared skills and a machine-wide test queue",
    "type": "module",
    "bin": {
        "ai-tools": "bin/ai-tools.mjs"
    },
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "test": "node scripts/test-lock.mjs run -- node --test --test-concurrency=1 scripts/*.test.mjs",
        "skills:sync": "node scripts/sync-agent-skills.mjs",
        "skills:check": "node scripts/sync-agent-skills.mjs --check",
        "tests:status": "node scripts/test-lock.mjs status"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CesarArdilaB/ai-tools.git"
    },
    "license": "MIT"
}
